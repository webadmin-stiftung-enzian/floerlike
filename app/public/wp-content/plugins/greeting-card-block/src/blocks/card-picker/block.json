{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "greeting-card-block/card-picker",
	"version": "0.4.0",
	"title": "Grusskarten-Auswahl",
	"category": "greeting-card",
	"description": "Slider mit den verknüpften Grusskarten.",
	"keywords": [
		"grusskarte",
		"slider",
		"karte"
	],
	"attributes": {
		"titel": {
			"type": "string",
			"default": ""
		},
		"slidesPerView": {
			"type": "number",
			"default": 1
		},
		"slidesPerViewMobile": {
			"type": "number",
			"default": 1
		},
		"showPrice": {
			"type": "boolean",
			"default": true
		},
		"showNavigation": {
			"type": "boolean",
			"default": true
		},
		"showPagination": {
			"type": "boolean",
			"default": false
		}
	},
	"ancestor": [
		"greeting-card-block/card-purchase"
	],
	"textdomain": "greeting-card-block",
	"usesContext": [
		"postId",
		"greeting-card-block/previewProductId"
	],
	"supports": {
		"html": false,
		"multiple": false,
		"reusable": false,
		"interactivity": true
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"viewScriptModule": [
		"greeting-card-block/store",
		"file:./view.js"
	]
}
