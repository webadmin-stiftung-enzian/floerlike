{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "product-showcase/variation-range",
	"version": "0.1.0",
	"title": "Varianten-Spanne",
	"category": "product-showcase",
	"icon": "leftright",
	"description": "Werte der Varianten eines Produkts als Spanne, z. B. „Grösse: klein – gross“ oder „Grösse: ca. 35 – 55 cm Ø“. Für die Produktvorlage einer Produktsammlung oder die Produktseite.",
	"keywords": [
		"variante",
		"attribut",
		"grösse",
		"preis",
		"spanne"
	],
	"textdomain": "product-showcase-block",
	"usesContext": [
		"postId",
		"postType"
	],
	"attributes": {
		"label": {
			"type": "string",
			"default": ""
		},
		"attribute": {
			"type": "string",
			"default": ""
		},
		"value": {
			"type": "string",
			"default": "term"
		}
	},
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"background": false
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"spacing": {
			"margin": true
		}
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
