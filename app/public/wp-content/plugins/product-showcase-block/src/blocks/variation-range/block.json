{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "product-showcase/variation-range",
	"version": "0.1.0",
	"title": "Produktangabe",
	"category": "product-showcase",
	"icon": "leftright",
	"description": "Grösse, Preis oder Durchmesser eines Produkts – bei Varianten als Spanne („Grösse: klein – gross“) oder Einzelwert mit Zusatztext („ab CHF 35.00“). Für die Produktvorlage einer Produktsammlung oder die Produktseite.",
	"keywords": [
		"variante",
		"attribut",
		"grösse",
		"preis",
		"durchmesser",
		"spanne",
		"ab-preis"
	],
	"textdomain": "product-showcase-block",
	"usesContext": [
		"postId",
		"postType"
	],
	"attributes": {
		"label": {
			"type": "string",
			"default": ""
		},
		"attribute": {
			"type": "string",
			"default": ""
		},
		"value": {
			"type": "string",
			"default": "term"
		},
		"display": {
			"type": "string",
			"default": "range"
		},
		"prefix": {
			"type": "string",
			"default": ""
		},
		"suffix": {
			"type": "string",
			"default": ""
		},
		"affixOnlyIfMultiple": {
			"type": "boolean",
			"default": true
		},
		"products": {
			"type": "string",
			"enum": [
				"variable",
				"all",
				"simple"
			],
			"default": "variable"
		}
	},
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"background": false
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"spacing": {
			"margin": true
		}
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
